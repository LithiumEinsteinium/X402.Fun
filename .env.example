# X402.Fun Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git — it's in .gitignore.

# ── Solana Program ─────────────────────────────────────────────────────────────
# Set this after running: solana-keygen pubkey program-keypair.json
PROGRAM_ID=NEW_PROGRAM_ID

SOLANA_RPC_URL=https://api.devnet.solana.com
CLUSTER=devnet

# ── Oracle Wallet ──────────────────────────────────────────────────────────────
# Base58-encoded private key of the oracle wallet.
# The oracle pays rent for x402 receipt PDAs on every launch/buy/sell.
# Wallet needs at least 0.5 SOL on devnet at all times.
# Generate: solana-keygen new --outfile oracle-keypair.json
# Export:   cat oracle-keypair.json | node -e "const bs58=require('bs58');const d=JSON.parse(require('fs').readFileSync('/dev/stdin','utf8'));process.stdout.write(bs58.encode(Buffer.from(d)))"
ORACLE_PRIVATE_KEY=

# ── Admin Wallet ───────────────────────────────────────────────────────────────
# Used only by scripts/initialize-program.js (one-time setup).
# Must be the upgrade authority keypair that deployed the program.
ADMIN_PRIVATE_KEY=

# ── Fee Recipient ──────────────────────────────────────────────────────────────
# Public key of the wallet that receives platform fees (1% of every trade).
# Set during initialize — changing it requires redeployment.
FEE_RECIPIENT=

# ── Database (optional) ────────────────────────────────────────────────────────
# If not set, token listings use in-memory storage (resets on restart).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Telegram Bot (optional) ────────────────────────────────────────────────────
# Announces new launches, buys, sells, and graduations to a channel.
# Get token from @BotFather. Channel ID format: -1001234567890
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=

# ── PumpFun / PumpSwap Program IDs ────────────────────────────────────────────
# These are stable addresses — only change for mainnet (same addresses).
PUMPFUN_PROGRAM_ID=6EF8rrecth5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
PUMPSWAP_PROGRAM_ID=pAMMBay6oceH9fJKBRHGP5D4bD4sWpmSwMn52FMfXEA

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=10000
